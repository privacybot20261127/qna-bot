# 이 파일을 .env로 복사한 뒤 값을 입력하세요. .env는 절대 커밋하지 마세요.

# LLM 선택: openai 또는 anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
# OpenAI 콘솔에 표시된 모델 ID
LLM_MODEL=gpt-5.6-sol
# OpenAI 추론 모델이면 low | medium | high, 아니면 비워 둠
LLM_REASONING_EFFORT=

# Claude를 쓸 때: LLM_PROVIDER=anthropic, LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Claude 추론 강도 (low | medium | high)
QNA_EFFORT=low
CHAT_EFFORT=low

# 기본값은 약 2GB. PC 사양이 낮으면 jhgan/ko-sroberta-multitask(약 450MB)로 바꿔도 됨
# 바꾼 뒤에는 03_build_index.py를 다시 실행해야 함
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_DIR=vectordb
# 검색할 조문 수, 이 유사도(0~1)보다 낮으면 "관련 조문 없음"으로 답함
TOP_K=5
MIN_SCORE=0.45
